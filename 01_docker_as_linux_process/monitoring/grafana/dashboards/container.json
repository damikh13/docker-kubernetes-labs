{
  "uid": "lab1-container",
  "title": "lab-api container (cgroup)",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memory: working set vs limit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cgroup_memory_working_set_bytes{name=\"lab-api\"}",
          "legendFormat": "working set"
        },
        {
          "refId": "B",
          "expr": "cgroup_memory_max_bytes{name=\"lab-api\"}",
          "legendFormat": "limit (memory.max)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory: % of limit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cgroup_memory_working_set_bytes{name=\"lab-api\"} / cgroup_memory_max_bytes{name=\"lab-api\"}",
          "legendFormat": "% of limit"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU: cores used vs limit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cgroup_cpu_usage_seconds_total{name=\"lab-api\"}[1m])",
          "legendFormat": "used (cores)"
        },
        {
          "refId": "B",
          "expr": "cgroup_cpu_quota_cores{name=\"lab-api\"}",
          "legendFormat": "limit (cpu.max)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU throttling: share of throttled periods",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cgroup_cpu_throttled_periods_total{name=\"lab-api\"}[1m]) / rate(cgroup_cpu_periods_total{name=\"lab-api\"}[1m])",
          "legendFormat": "throttled periods"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU time lost to throttling (s per s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cgroup_cpu_throttled_seconds_total{name=\"lab-api\"}[1m])",
          "legendFormat": "throttled seconds/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Processes: pids.current vs pids.max",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cgroup_pids_current{name=\"lab-api\"}",
          "legendFormat": "pids.current"
        },
        {
          "refId": "B",
          "expr": "cgroup_pids_max{name=\"lab-api\"}",
          "legendFormat": "pids.max"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Restarts in selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "changes(docker_container_restart_count{name=\"lab-api\"}[$__range])"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "OOM kills (memory.events, current cgroup)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cgroup_memory_oom_kill_total{name=\"lab-api\"}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Times the memory limit was hit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cgroup_memory_limit_hits_total{name=\"lab-api\"}"
        }
      ]
    }
  ]
}